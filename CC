DECLARE @CurrentDate DATE = CAST(GETDATE() AS DATE);

SELECT
    CASE
        WHEN Valid_From > @CurrentDate
            THEN 'NOT YET VALID'

        WHEN Valid_To < @CurrentDate
            THEN 'EXPIRED'

        ELSE 'VALID'
    END AS ProductStatus,

    COUNT(*) AS TotalRows,

    COUNT(DISTINCT Material_Number) AS TotalProducts

FROM TB_PriceMaster
WHERE CompanyCode = 1070
  AND SalesOrganisation = 'MCPL'
  AND Condition_Type = 'ZBAG'

GROUP BY
    CASE
        WHEN Valid_From > @CurrentDate
            THEN 'NOT YET VALID'
        WHEN Valid_To < @CurrentDate
            THEN 'EXPIRED'
        ELSE 'VALID'
    END;

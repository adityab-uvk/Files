        i.Material_Description,
        i.Quantity,
        i.Rate,
         CAST(i.Qty_Into_Rate_Amt AS DECIMAL(18,3)) AS Amount
    FROM TB_Cart_Items i
    WHERE i.CartId = (
        SELECT CartId
        FROM TB_Create_Dealer_Order
        WHERE CreateOrderNumber = @CreateOrderNumber

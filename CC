IF @CompanyCode = 1070
BEGIN

    ;WITH Products AS
    (
        SELECT
            PM.CompanyCode,
            PM.Material_Number,
            PM.Material_Description,
            PM.Crop,
            PM.Variety,
            PM.Stage,
            PM.Grade,
            PM.Unit_Of_Measurement,

            -- 1070: Category-wise image
            CI.APIURL AS ImagePath,

            PM.Condition_Amount,

            PM.PackSize,
            PM.DIVISION,

            ROW_NUMBER() OVER
            (
                PARTITION BY PM.Material_Number
                ORDER BY
                    PM.Valid_To DESC,
                    PM.Valid_From DESC,
                    PM.Id DESC
            ) AS RowNum

        FROM TB_PriceMaster PM WITH (NOLOCK)

        -- Category image for Company 1070
        LEFT JOIN CategoryImages CI WITH (NOLOCK)
            ON CI.CompanyCode = 1070
            AND LTRIM(RTRIM(UPPER(CI.CategoryName))) =
                LTRIM(RTRIM(UPPER(PM.Crop)))

        WHERE PM.CompanyCode = 1070

          -- 1070 uses MCPL
          AND PM.SalesOrganisation = 'MCPL'

          -- Only product/base price
          AND PM.Condition_Type = 'ZBAG'

          -- Requested variety
          AND PM.Variety = @Variety

          -- Only products having category image
          AND CI.APIURL IS NOT NULL

          -- Do not show UNKNOWN products
          AND UPPER(LTRIM(RTRIM(PM.Crop))) <> 'UNKNOWN'

          -- Validity filtering
          AND
          (
              @CurrentDate >= PM.Valid_From
              OR PM.Valid_From IS NULL
          )

          AND
          (
              @CurrentDate <= PM.Valid_To
              OR PM.Valid_To IS NULL
          )

          -- Do not show deleted products
          AND
          (
              PM.Deletion_Indicator IS NULL
              OR PM.Deletion_Indicator NOT LIKE '%X%'
          )
    )

    SELECT
        CompanyCode,
        Material_Number,
        Material_Description,
        Crop,
        Variety,
        Stage,
        Grade,
        Unit_Of_Measurement,
        ImagePath,
        Condition_Amount,
        PackSize,
        DIVISION AS Division
    FROM Products
    WHERE RowNum = 1
    ORDER BY Material_Number;

    RETURN;
END;

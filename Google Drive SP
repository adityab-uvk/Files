SELECT DISTINCT U.Email
FROM Users U
WHERE U.CompanyCode = 1049
  AND U.Email IS NOT NULL
  AND
  (
      U.RoleId IN (5, 9, 11)

      OR
      (
          U.UserCode = '25035256'
          AND EXISTS
          (
              SELECT 1
              FROM TB_Create_Dealer_Order O
              WHERE O.CreateOrderNumber = @CreateOrderNumber
                AND O.RMCode = '25035256'
          )
      )
  );


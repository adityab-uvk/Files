DECLARE @CurrentDate DATE = CAST(GETDATE() AS DATE);

SELECT
    CompanyCode,
    Material_Number,
    Material_Description,
    Crop,
    Valid_From,
    Valid_To,
    Deletion_Indicator
FROM TB_PriceMaster
WHERE CompanyCode = 1070
  AND Condition_Type = 'ZBAG'
  AND (
        Valid_From IS NULL
        OR @CurrentDate >= Valid_From
      )
  AND (
        Valid_To IS NULL
        OR @CurrentDate <= Valid_To
      )
  AND (
        Deletion_Indicator IS NULL
        OR Deletion_Indicator NOT LIKE '%X%'
      );

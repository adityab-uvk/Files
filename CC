DECLARE @CurrentDate DATE = CAST(GETDATE() AS DATE);

SELECT
    Material_Number,
    Material_Description,
    Crop,
    Valid_From,
    Valid_To,
    Condition_Amount,
    CASE
        WHEN Valid_To < @CurrentDate THEN 'EXPIRED'
        WHEN Valid_From > @CurrentDate THEN 'NOT YET VALID'
        ELSE 'VALID'
    END AS ProductStatus
FROM TB_PriceMaster
WHERE CompanyCode = 1070
  AND SalesOrganisation = 'MCPL'
  AND Condition_Type = 'ZBAG'
ORDER BY Valid_To;

ALTER PROCEDURE [dbo].[GetAllProductOffering_MASL]
    @CompanyCode INT
AS
BEGIN
    SET NOCOUNT ON;

    BEGIN TRY

        WITH Ranked AS
        (
            SELECT 
                PM.CompanyCode,
                ISNULL(PM.ProductId, PI.ProductId) AS ProductId,
                PM.Material_Number,
                PM.Material_Description,
                PM.Crop,
                PM.Variety,
                PM.Stage,
                PM.Grade,
                PM.Unit_Of_Measurement,

                -- Image logic
                CASE 
                    WHEN PM.CompanyCode = 1070 
                        THEN CI.APIURL
                    ELSE PI.APIURL
                END AS ImagePath,

                PM.Condition_Amount,
                PM.Priority,
                PM.PackSize,
                PM.DIVISION,

                ROW_NUMBER() OVER
                (
                    PARTITION BY PM.Material_Number 
                    ORDER BY PM.Priority ASC
                ) AS RowNum

            FROM TB_PriceMaster PM

            -- Existing product-wise image logic for other companies
            LEFT JOIN TB_ProductImages PI
                ON PM.CompanyCode = PI.CompanyCode
                AND PM.CompanyCode <> 1070
                AND (
                    PM.Material_Description LIKE PI.ProductName + '%'
                    OR PM.Material_Description LIKE '%' + PI.ProductName + '%'
                )

            -- New category-wise image logic for Company 1070
            LEFT JOIN CategoryImages CI
                ON PM.CompanyCode = 1070
                AND CI.CompanyCode = 1070
                AND LTRIM(RTRIM(UPPER(CI.CategoryName))) =
                    LTRIM(RTRIM(UPPER(PM.Crop)))

            WHERE PM.CompanyCode = @CompanyCode

              AND (
                    PM.Deletion_Indicator <> 'X'
                    OR PM.Deletion_Indicator IS NULL
                    OR PM.Deletion_Indicator = ''
                  )

              -- Image must exist
              AND
              (
                    (@CompanyCode = 1070 AND CI.APIURL IS NOT NULL)
                    OR
                    (@CompanyCode <> 1070 AND PI.APIURL IS NOT NULL)
              )
        )

        SELECT 
            CompanyCode,
            Material_Number,
            Material_Description,
            Crop,
            Variety,
            Stage,
            Grade,
            Unit_Of_Measurement,
            ImagePath,
            Condition_Amount,
            PackSize,
            Division
        FROM Ranked
        WHERE RowNum = 1
        ORDER BY Priority ASC;

    END TRY

    BEGIN CATCH

        INSERT INTO ErrorLog_GetProductOffering
        (
            ErrorMessage,
            ErrorSeverity,
            ErrorState,
            ProcedureName,
            ErrorLine,
            ErrorDate
        )
        VALUES
        (
            ERROR_MESSAGE(),
            ERROR_SEVERITY(),
            ERROR_STATE(),
            'GetAllProductOffering_MASL',
            ERROR_LINE(),
            GETDATE()
        );

        SELECT 
            NULL AS CompanyCode,
            NULL AS Material_Number,
            NULL AS Material_Description,
            NULL AS Crop,
            NULL AS Variety,
            NULL AS Stage,
            NULL AS Grade,
            NULL AS Unit_Of_Measurement,
            NULL AS ImagePath,
            NULL AS Condition_Amount,
            NULL AS PackSize,
            NULL AS Division;

    END CATCH;
END
GO

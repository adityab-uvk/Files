    BillingDocument,
    BillingDate,
    Sold_To_Party,
    SalesOrganisation,
    SalesOrderNo,
    TotalInvoiceValue,
    CreatedOn
FROM TB_InvoiceHeader
WHERE SalesOrderNo IN
(
    '0304356801',
    '0304623123'
)
AND SalesOrganisation = 'MZ01';



DECLARE @CurrentDate DATE = CAST(GETDATE() AS DATE);

SELECT
    PM.CompanyCode,
    PM.Material_Number,
    PM.Material_Description,
    PM.Crop,
    PM.SalesOrganisation,
    PM.Condition_Amount,
    PM.Valid_From,
    PM.Valid_To,
    PM.Deletion_Indicator
FROM TB_PriceMaster PM
WHERE PM.CompanyCode = 1070
  AND PM.Condition_Type = 'ZBAG'
  AND PM.SalesOrganisation = 'MCPL'
  AND (PM.Valid_From IS NULL OR @CurrentDate >= PM.Valid_From)
  AND (PM.Valid_To IS NULL OR @CurrentDate <= PM.Valid_To)
  AND (
        PM.Deletion_Indicator IS NULL
        OR PM.Deletion_Indicator NOT LIKE '%X%'
      )
ORDER BY PM.Material_Number;

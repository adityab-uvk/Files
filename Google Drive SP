ALTER PROCEDURE [dbo].[GetCompletedDispatches]
    @UserCode NVARCHAR(50),
    @CustomerCode NVARCHAR(50) = NULL
AS
BEGIN
    SET NOCOUNT ON;

    DECLARE @RoleId INT;

    SET @UserCode =
        NULLIF(LTRIM(RTRIM(@UserCode)), '');

    SET @CustomerCode =
        NULLIF(LTRIM(RTRIM(@CustomerCode)), '');

    ------------------------------------------------------------
    -- Get logged-in user's RoleId
    ------------------------------------------------------------
    SELECT TOP 1
        @RoleId = U.RoleId
    FROM Users U
    WHERE LTRIM(RTRIM(U.UserCode)) = @UserCode
      AND U.CompanyCode = 1054;

    IF @RoleId IS NULL
    BEGIN
        RAISERROR(
            'User not found or RoleId is missing for CompanyCode 1054.',
            16,
            1
        );

        RETURN;
    END;

    ------------------------------------------------------------
    -- Find users under RoleId 3 and RoleId 4 authorities
    ------------------------------------------------------------
    ;WITH UserHierarchy AS
    (
        SELECT
            U.UserCode
        FROM Users U
        WHERE LTRIM(RTRIM(U.UserCode)) = @UserCode
          AND U.CompanyCode = 1054

        UNION ALL

        SELECT
            Child.UserCode
        FROM Users Child
        INNER JOIN UserHierarchy Parent
            ON LTRIM(RTRIM(Child.RepManCode))
             = LTRIM(RTRIM(Parent.UserCode))
        WHERE Child.CompanyCode = 1054
          AND ISNULL(Child.IsActive, 1) = 1
    )

    SELECT
        DR.*,
        DO.SoNumber,
        DO.ProductName,
        DO.SecondaryProductName,
        IH.BillingDocument AS InvoiceNumber

    FROM DispatchRequests DR

    INNER JOIN DealerOrderMHZPC DO
        ON DR.OrderNumber = DO.OrderNumber
       AND DR.ProductId = DO.ProductId

    INNER JOIN TB_InvoiceHeader IH
        ON LTRIM(RTRIM(DO.SoNumber))
         = LTRIM(RTRIM(IH.SalesOrderNo))
       AND LTRIM(RTRIM(IH.SalesOrganisation)) = 'MZ01'

    WHERE LTRIM(RTRIM(DR.DispatchStatus)) = 'Complete'

      AND
      (
          --------------------------------------------------------
          -- RoleId 1: Customer sees only own dispatches
          --------------------------------------------------------
          (
              @RoleId = 1
              AND LTRIM(RTRIM(DR.CustomerCode)) = @UserCode
          )

          --------------------------------------------------------
          -- RoleId 2: TM sees assigned customers
          --------------------------------------------------------
          OR
          (
              @RoleId = 2

              AND
              (
                  @CustomerCode IS NULL
                  OR LTRIM(RTRIM(DR.CustomerCode)) = @CustomerCode
              )

              AND EXISTS
              (
                  SELECT 1
                  FROM TB_CustomerMaster CM
                  WHERE LTRIM(RTRIM(CM.CustomerCode))
                        = LTRIM(RTRIM(DR.CustomerCode))
                    AND LTRIM(RTRIM(CM.TM)) = @UserCode
                    AND CM.CompanyCode = 1054
              )
          )

          --------------------------------------------------------
          -- RoleId 3 and 4: Hierarchy customers
          --------------------------------------------------------
          OR
          (
              @RoleId BETWEEN 3 AND 4

              AND
              (
                  @CustomerCode IS NULL
                  OR LTRIM(RTRIM(DR.CustomerCode)) = @CustomerCode
              )

              AND EXISTS
              (
                  SELECT 1
                  FROM TB_CustomerMaster CM
                  WHERE LTRIM(RTRIM(CM.CustomerCode))
                        = LTRIM(RTRIM(DR.CustomerCode))
                    AND CM.CompanyCode = 1054
                    AND LTRIM(RTRIM(CM.TM)) IN
                    (
                        SELECT
                            LTRIM(RTRIM(UH.UserCode))
                        FROM UserHierarchy UH
                    )
              )
          )

          --------------------------------------------------------
          -- RoleId greater than 4:
          -- Business Admin sees all completed dispatches
          --------------------------------------------------------
          OR
          (
              @RoleId > 4

              -- Apply selected customer only when provided
              AND
              (
                  @CustomerCode IS NULL
                  OR LTRIM(RTRIM(DR.CustomerCode)) = @CustomerCode
              )

              -- Restrict records to CompanyCode 1054
              AND EXISTS
              (
                  SELECT 1
                  FROM TB_CustomerMaster CM
                  WHERE LTRIM(RTRIM(CM.CustomerCode))
                        = LTRIM(RTRIM(DR.CustomerCode))
                    AND CM.CompanyCode = 1054
              )
          )
      )

    ORDER BY
        DR.CreatedOn DESC,
        DR.Id DESC

    OPTION (MAXRECURSION 100);
END;
GO

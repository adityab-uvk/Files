DECLARE @CompanyCode BIGINT = '1054';
DECLARE @ZMCode NVARCHAR(50) = '23147299';

---------------------------------------------------------
-- ZM
---------------------------------------------------------
SELECT
    'ZM' AS LevelName,
    UserCode,
    RoleId,
    RepManCode
FROM dbo.Users
WHERE CompanyCode = @CompanyCode
  AND LTRIM(RTRIM(UserCode)) = @ZMCode;

---------------------------------------------------------
-- RMs
---------------------------------------------------------
SELECT
    'RM' AS LevelName,
    UserCode,
    RoleId,
    RepManCode
FROM dbo.Users
WHERE CompanyCode = @CompanyCode

  AND LTRIM(RTRIM(RepManCode)) = @ZMCode;

---------------------------------------------------------
-- TMs
---------------------------------------------------------
SELECT
    'TM' AS LevelName,
    tm.UserCode,
    tm.RoleId,
    tm.RepManCode
FROM dbo.Users tm
WHERE tm.CompanyCode = @CompanyCode

  AND EXISTS
  (
      SELECT 1
      FROM dbo.Users rm
      WHERE rm.CompanyCode = @CompanyCode
  
        AND LTRIM(RTRIM(rm.UserCode))
            = LTRIM(RTRIM(tm.RepManCode))
        AND LTRIM(RTRIM(rm.RepManCode)) = @ZMCode
  );

---------------------------------------------------------
-- Customer Master Customers
---------------------------------------------------------
SELECT DISTINCT
    cm.CustomerCode,
    cm.TM,
    cm.RegionDescription
FROM dbo.TB_CustomerMaster cm
WHERE cm.CompanyCode = @CompanyCode
  AND EXISTS
  (
      SELECT 1
      FROM dbo.Users tm
      INNER JOIN dbo.Users rm
          ON rm.CompanyCode = tm.CompanyCode
     
         AND LTRIM(RTRIM(rm.UserCode))
             = LTRIM(RTRIM(tm.RepManCode))
      WHERE tm.CompanyCode = @CompanyCode

        AND LTRIM(RTRIM(rm.RepManCode)) = @ZMCode
        AND LTRIM(RTRIM(cm.TM))
            = LTRIM(RTRIM(tm.UserCode))
  );






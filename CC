SELECT 
    SalesOrganisation,
    Condition_Table,
    Condition_Type,
    COUNT(*) AS RecordCount
FROM TB_PriceMaster
WHERE CompanyCode = 1070
  AND Condition_Type IN ('ZBAG', 'ZDIS')
GROUP BY 
    SalesOrganisation,
    Condition_Table,
    Condition_Type
ORDER BY 
    SalesOrganisation,
    Condition_Table,
    Condition_Type;

ALTER PROCEDURE [dbo].[CheckCartItemsDivisions]
    @CartId BIGINT,
    @HasSameDivision BIT OUTPUT,
    @DivisionName NVARCHAR(100) OUTPUT,
    @ErrorMessage NVARCHAR(500) OUTPUT
AS
BEGIN
    SET NOCOUNT ON;

    DECLARE @ErrorMessageDB NVARCHAR(MAX),
            @ErrorSeverity INT,
            @ErrorState INT;

    DECLARE @DivisionCount INT;
    DECLARE @ItemCount INT;
    DECLARE @CustomerCode NVARCHAR(50);

    DECLARE @HasFieldCropEnrollment BIT = 0;
    DECLARE @HasVegetableEnrollment BIT = 0;

    DECLARE @CartHasFieldCrop BIT = 0;
    DECLARE @CartHasVegetable BIT = 0;

    BEGIN TRY

        -------------------------------------------------
        -- Initialize Output Parameters
        -------------------------------------------------

        SET @HasSameDivision = 0;
        SET @DivisionName = NULL;
        SET @ErrorMessage = NULL;


        -------------------------------------------------
        -- Step 1: Check if cart has any items
        -------------------------------------------------

        SELECT @ItemCount = COUNT(CartItemId)
        FROM TB_Cart_Items
        WHERE CartId = @CartId;


        IF @ItemCount = 0
        BEGIN
            SET @HasSameDivision = 0;
            SET @DivisionName = NULL;
            SET @ErrorMessage = 'Cart is empty or does not exist.';
            RETURN;
        END


        -------------------------------------------------
        -- TEMPORARY LOGIC FOR COMPANY 1070
        -------------------------------------------------
        -- Business rules for CompanyCode 1070 are not
        -- finalized yet.
        --
        -- Therefore:
        -- 1. Skip customer enrollment validation.
        -- 2. Do not check TB_CreditLimitOfDealer.
        -- 3. Allow the cart to proceed.
        --
        -- Existing companies continue with the
        -- existing enrollment/division logic below.
        -------------------------------------------------

        IF EXISTS
        (
            SELECT 1
            FROM TB_Cart_Items
            WHERE CartId = @CartId
              AND CompanyCode = 1070
        )
        BEGIN

            -------------------------------------------------
            -- Count divisions present in 1070 cart
            -------------------------------------------------

            SELECT @DivisionCount = COUNT(DISTINCT Division)
            FROM TB_Cart_Items
            WHERE CartId = @CartId
              AND CompanyCode = 1070
              AND Division IS NOT NULL;


            -------------------------------------------------
            -- If cart contains exactly one division
            -------------------------------------------------

            IF @DivisionCount = 1
            BEGIN

                SELECT TOP 1
                    @DivisionName = Division
                FROM TB_Cart_Items
                WHERE CartId = @CartId
                  AND CompanyCode = 1070
                  AND Division IS NOT NULL;

                SET @HasSameDivision = 1;
                SET @ErrorMessage = NULL;

                RETURN;
            END


            -------------------------------------------------
            -- If multiple divisions exist
            --
            -- Temporary behavior for 1070:
            -- Allow the cart because business rules are
            -- not finalized yet.
            -------------------------------------------------

            IF @DivisionCount > 1
            BEGIN
                SET @HasSameDivision = 1;
                SET @DivisionName = 'Mixed';
                SET @ErrorMessage = NULL;

                RETURN;
            END


            -------------------------------------------------
            -- If division is NULL
            --
            -- Temporary behavior for 1070:
            -- Allow the cart.
            -------------------------------------------------

            IF @DivisionCount = 0
            BEGIN
                SET @HasSameDivision = 1;
                SET @DivisionName = NULL;
                SET @ErrorMessage = NULL;

                RETURN;
            END

        END


        -------------------------------------------------
        -- Step 2: Get customer code from cart items
        --
        -- Existing logic for companies other than 1070
        -------------------------------------------------

        SELECT TOP 1
            @CustomerCode = UserCode
        FROM TB_Cart_Items
        WHERE CartId = @CartId;


        -------------------------------------------------
        -- Step 3: Check customer's division enrollments
        -------------------------------------------------

        SELECT
            @HasFieldCropEnrollment =
                CASE
                    WHEN COUNT(*) > 0 THEN 1
                    ELSE 0
                END
        FROM TB_CreditLimitOfDealer
        WHERE CustomerCode = @CustomerCode
          AND Division = '25';


        SELECT
            @HasVegetableEnrollment =
                CASE
                    WHEN COUNT(*) > 0 THEN 1
                    ELSE 0
                END
        FROM TB_CreditLimitOfDealer
        WHERE CustomerCode = @CustomerCode
          AND Division = 'VG';


        -------------------------------------------------
        -- Step 4: Check divisions present in cart
        -------------------------------------------------

        SELECT
            @CartHasFieldCrop =
                CASE
                    WHEN COUNT(*) > 0 THEN 1
                    ELSE 0
                END
        FROM TB_Cart_Items
        WHERE CartId = @CartId
          AND Division = '25';


        SELECT
            @CartHasVegetable =
                CASE
                    WHEN COUNT(*) > 0 THEN 1
                    ELSE 0
                END
        FROM TB_Cart_Items
        WHERE CartId = @CartId
          AND Division = 'VG';


        -------------------------------------------------
        -- Step 5: Count DISTINCT divisions in cart
        -------------------------------------------------

        SELECT @DivisionCount = COUNT(DISTINCT Division)
        FROM TB_Cart_Items
        WHERE CartId = @CartId
          AND Division IS NOT NULL;


        -------------------------------------------------
        -- Step 6: Existing business logic
        -------------------------------------------------


        -------------------------------------------------
        -- Case 1:
        -- Customer has BOTH divisions (25 and VG)
        -------------------------------------------------

        IF @HasFieldCropEnrollment = 1
           AND @HasVegetableEnrollment = 1
        BEGIN

            -------------------------------------------------
            -- Cart contains both divisions
            -------------------------------------------------

            IF @CartHasFieldCrop = 1
               AND @CartHasVegetable = 1
            BEGIN

                SET @HasSameDivision = 0;
                SET @DivisionName = 'Mixed';

                SET @ErrorMessage =
                    'Please place separate indents for Field Crop and Vegetable Crop products. Only one product type is allowed per indent.';

                RETURN;

            END


            -------------------------------------------------
            -- Cart contains only one division
            -------------------------------------------------

            ELSE IF @DivisionCount = 1
            BEGIN

                SELECT TOP 1
                    @DivisionName = Division
                FROM TB_Cart_Items
                WHERE CartId = @CartId
                  AND Division IS NOT NULL;

                SET @HasSameDivision = 1;
                SET @ErrorMessage = NULL;

                RETURN;

            END

        END


        -------------------------------------------------
        -- Case 2:
        -- Customer has ONLY Field Crop enrollment (25)
        -------------------------------------------------

        ELSE IF @HasFieldCropEnrollment = 1
            AND @HasVegetableEnrollment = 0
        BEGIN

            -------------------------------------------------
            -- Cart contains Vegetable products
            -------------------------------------------------

            IF @CartHasVegetable = 1
            BEGIN

                SET @HasSameDivision = 0;
                SET @DivisionName = 'VG';

                SET @ErrorMessage =
                    'You are Not Enrolled for Vegetable Crop Products. You cannot place the Indent';

                RETURN;

            END


            -------------------------------------------------
            -- Cart contains only Field Crop products
            -------------------------------------------------

            ELSE IF @CartHasFieldCrop = 1
                AND @DivisionCount = 1
            BEGIN

                SET @HasSameDivision = 1;
                SET @DivisionName = '25';
                SET @ErrorMessage = NULL;

                RETURN;

            END

        END


        -------------------------------------------------
        -- Case 3:
        -- Customer has ONLY Vegetable enrollment (VG)
        -------------------------------------------------

        ELSE IF @HasFieldCropEnrollment = 0
            AND @HasVegetableEnrollment = 1
        BEGIN

            -------------------------------------------------
            -- Cart contains Field Crop products
            -------------------------------------------------

            IF @CartHasFieldCrop = 1
            BEGIN

                SET @HasSameDivision = 0;
                SET @DivisionName = '25';

                SET @ErrorMessage =
                    'You are Not Enrolled for Field Crop Products. You cannot place the Indent';

                RETURN;

            END


            -------------------------------------------------
            -- Cart contains only Vegetable products
            -------------------------------------------------

            ELSE IF @CartHasVegetable = 1
                AND @DivisionCount = 1
            BEGIN

                SET @HasSameDivision = 1;
                SET @DivisionName = 'VG';
                SET @ErrorMessage = NULL;

                RETURN;

            END

        END


        -------------------------------------------------
        -- Case 4:
        -- Customer has NO enrollment for either division
        -------------------------------------------------

        ELSE IF @HasFieldCropEnrollment = 0
            AND @HasVegetableEnrollment = 0
        BEGIN

            SET @HasSameDivision = 0;
            SET @DivisionName = NULL;

            SET @ErrorMessage =
                'You are not enrolled for any product divisions. Please contact administrator.';

            RETURN;

        END

    END TRY


    BEGIN CATCH

        -------------------------------------------------
        -- Capture error details
        -------------------------------------------------

        SET @ErrorMessageDB = ERROR_MESSAGE();
        SET @ErrorSeverity = ERROR_SEVERITY();
        SET @ErrorState = ERROR_STATE();


        -------------------------------------------------
        -- Log error
        -------------------------------------------------

        INSERT INTO Error_Log
        (
            ProcedureName,
            ErrorMessage,
            ErrorSeverity,
            ErrorState,
            ErrorDate
        )
        VALUES
        (
            'CheckCartItemsDivisions',
            @ErrorMessageDB,
            @ErrorSeverity,
            @ErrorState,
            GETDATE()
        );


        -------------------------------------------------
        -- Return error
        -------------------------------------------------

        SET @HasSameDivision = 0;
        SET @DivisionName = NULL;
        SET @ErrorMessage =
            'Error while validating cart divisions: '
            + @ErrorMessageDB;

    END CATCH;

END;
GO

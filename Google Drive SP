ALTER PROCEDURE [dbo].[GetPartialDispatches]
    @UserCode NVARCHAR(50),
    @CustomerCode NVARCHAR(50) = NULL
AS
BEGIN
    SET NOCOUNT ON;

    DECLARE @RoleId INT;

    SET @UserCode = NULLIF(LTRIM(RTRIM(@UserCode)), '');
    SET @CustomerCode = NULLIF(LTRIM(RTRIM(@CustomerCode)), '');

    -- Get logged-in user's RoleId
    SELECT TOP 1
        @RoleId = UM.RoleId
    FROM Users UM
    WHERE LTRIM(RTRIM(UM.UserCode)) = @UserCode;

    IF @RoleId IS NULL
    BEGIN
        RAISERROR('User not found or RoleId is missing.', 16, 1);
        RETURN;
    END;

    -- Find all users below the logged-in user
    ;WITH UserHierarchy AS
    (
        SELECT
            U.UserCode
        FROM Users U
        WHERE LTRIM(RTRIM(U.UserCode)) = @UserCode

        UNION ALL

        SELECT
            Child.UserCode
        FROM Users Child
        INNER JOIN UserHierarchy Parent
            ON LTRIM(RTRIM(Child.RepManCode))
             = LTRIM(RTRIM(Parent.UserCode))
    )

    SELECT
        DR.*,
        DO.SoNumber,
        DO.ProductName,
        DO.SecondaryProductName,
        IH.BillingDocument AS InvoiceNumber

    FROM DispatchRequests DR

    INNER JOIN DealerOrderMHZPC DO
        ON DR.OrderNumber = DO.OrderNumber
       AND DR.ProductId = DO.ProductId

    INNER JOIN TB_InvoiceHeader IH
        ON LTRIM(RTRIM(DO.SoNumber))
         = LTRIM(RTRIM(IH.SalesOrderNo))
       AND LTRIM(RTRIM(IH.SalesOrganisation)) = 'MZ01'

    WHERE DR.DispatchStatus = 'Partial'

      AND
      (
          -------------------------------------------------------------
          -- RoleId 1: Customer can see only own dispatches
          -------------------------------------------------------------
          (
              @RoleId = 1
              AND LTRIM(RTRIM(DR.CustomerCode)) = @UserCode
          )

          -------------------------------------------------------------
          -- RoleId 2: TM can see assigned customers
          -------------------------------------------------------------
          OR
          (
              @RoleId = 2

              AND
              (
                  (
                      @CustomerCode IS NOT NULL
                      AND LTRIM(RTRIM(DR.CustomerCode))
                          = @CustomerCode
                  )

                  OR

                  (
                      @CustomerCode IS NULL

                      AND LTRIM(RTRIM(DR.CustomerCode)) IN
                      (
                          SELECT
                              LTRIM(RTRIM(CM.CustomerCode))
                          FROM TB_CustomerMaster CM
                          WHERE LTRIM(RTRIM(CM.TM)) = @UserCode
                            AND CM.CompanyCode = 1054
                      )
                  )
              )
          )

          -------------------------------------------------------------
          -- RoleIds 3 and 4: See hierarchy customers
          -------------------------------------------------------------
          OR
          (
              @RoleId BETWEEN 3 AND 4

              AND
              (
                  (
                      @CustomerCode IS NOT NULL
                      AND LTRIM(RTRIM(DR.CustomerCode))
                          = @CustomerCode
                  )

                  OR

                  (
                      @CustomerCode IS NULL

                      AND LTRIM(RTRIM(DR.CustomerCode)) IN
                      (
                          SELECT
                              LTRIM(RTRIM(CM.CustomerCode))
                          FROM TB_CustomerMaster CM
                          WHERE CM.CompanyCode = 1054
                            AND LTRIM(RTRIM(CM.TM)) IN
                            (
                                SELECT
                                    LTRIM(RTRIM(UserCode))
                                FROM UserHierarchy
                            )
                      )
                  )
              )
          )

          -------------------------------------------------------------
          -- RoleId greater than 4: Business Admin sees all dispatches
          -------------------------------------------------------------
          OR
          (
              @RoleId > 4

              AND
              (
                  @CustomerCode IS NULL

                  OR LTRIM(RTRIM(DR.CustomerCode))
                     = @CustomerCode
              )
          )
      )

    ORDER BY
        DR.CreatedOn DESC,
        DR.Id DESC

    OPTION (MAXRECURSION 100);
END;
GO

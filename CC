    @PageSize    INT = 25
AS
BEGIN
    SET NOCOUNT ON;

    BEGIN TRY
        IF @RoleId NOT IN (1,2,3,4,5,6,7) RETURN;
        IF @RoleId = 1 RETURN;

        -- Create temp table ONCE (avoid multi-definition compile error)
        IF OBJECT_ID('tempdb..#Customers') IS NOT NULL DROP TABLE #Customers;

        CREATE TABLE #Customers
        (
            UserCode    NVARCHAR(50)  NOT NULL,
            CompanyCode BIGINT        NOT NULL,
            UserType    NVARCHAR(50)  NULL,
            Name        NVARCHAR(200) NULL,
            Email       NVARCHAR(256) NULL,
            RepManCode  NVARCHAR(50)  NULL,
            IsActive    BIT           NOT NULL,
            RoleId      INT           NOT NULL,
            UserId      BIGINT        NOT NULL
        );

        ---------------------------------------------------------------------
        -- TM (2)
        ---------------------------------------------------------------------
        IF @RoleId = 2
        BEGIN
            TRUNCATE TABLE #Customers;

            ;WITH HierarchyChain AS (
                SELECT U.UserCode, U.RoleId
                FROM dbo.Users U
                WHERE U.UserCode = @UserCode AND U.RoleId = 2 AND U.CompanyCode = @CompanyCode
                UNION ALL
                SELECT C.UserCode, C.RoleId
                FROM dbo.Users C
                INNER JOIN HierarchyChain HC ON C.RepManCode = HC.UserCode
                WHERE C.CompanyCode = @CompanyCode AND C.IsActive = 1
            )
            INSERT INTO #Customers (UserCode, CompanyCode, UserType, Name, Email, RepManCode, IsActive, RoleId, UserId)
            SELECT U.UserCode, U.CompanyCode, U.UserType, U.Name, U.Email, U.RepManCode, U.IsActive, U.RoleId, U.UserId
            FROM dbo.Users U
            INNER JOIN HierarchyChain HC ON U.UserCode = HC.UserCode
            WHERE U.RoleId = 1 AND U.CompanyCode = @CompanyCode AND U.IsActive = 1;

            SELECT COUNT(1) AS TotalCount FROM #Customers;


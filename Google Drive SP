CREATE OR ALTER PROCEDURE [dbo].[USP_ExportApproverHierarchy_1054]
AS
BEGIN
    SET NOCOUNT ON;

    SELECT
        C.CustomerCode AS CustomerCode,
        C.CustomerName AS CustomerName,

        -- TM name
        ISNULL(U1.Name, '') AS FirstApprover,

        -- Reporting manager name
        ISNULL(U2.Name, '') AS SecondApprover

    FROM dbo.TB_CustomerMaster C

    LEFT JOIN dbo.Users U1
        ON U1.CompanyCode = C.CompanyCode
        AND U1.UserCode = C.TM

    LEFT JOIN dbo.Users U2
        ON U2.CompanyCode = U1.CompanyCode
        AND U2.UserCode = U1.RepManCode

    WHERE C.CompanyCode = 1054

    ORDER BY
        C.CustomerCode;
END;
GO

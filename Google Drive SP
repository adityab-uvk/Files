DECLARE @CompanyCode BIGINT = 1054;

SELECT DISTINCT
    CM.TM AS TMCode,
    CM.CompanyCode AS CustomerMasterCompanyCode,
    U.CompanyCode AS UsersCompanyCode,
    U.Name AS UserName,
    U.RoleId,
    U.IsActive,
    U.RepManCode,
    CASE
        WHEN U.UserCode IS NULL THEN 'TM not found in Users'
        WHEN U.CompanyCode <> CM.CompanyCode THEN 'CompanyCode mismatch'
        ELSE 'Correct'
    END AS Issue
FROM TB_CustomerMaster CM
LEFT JOIN Users U
    ON LTRIM(RTRIM(U.UserCode)) = LTRIM(RTRIM(CM.TM))
WHERE CM.CompanyCode = @CompanyCode
  AND NULLIF(LTRIM(RTRIM(CM.TM)), '') IS NOT NULL
  AND
  (
      U.UserCode IS NULL
      OR U.CompanyCode <> CM.CompanyCode
  )
ORDER BY
    CM.TM,
    U.CompanyCode;



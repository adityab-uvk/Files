SELECT
    DR.Id AS DispatchRequestId,
    DR.CustomerCode,
    DR.OrderNumber,
    DR.ProductId,
    DR.DispatchStatus,
    DO.SoNumber,
    DO.ProductName,
    DO.SecondaryProductName
FROM DispatchRequests DR
LEFT JOIN DealerOrderMHZPC DO
    ON DR.OrderNumber = DO.OrderNumber
   AND DR.ProductId = DO.ProductId
WHERE DR.DispatchStatus = 'Partial'
  AND DR.Id IN (1, 2);

DECLARE @CurrentDate DATE = CAST(GETDATE() AS DATE);

SELECT
    COUNT(*) AS TotalMatchingRows,
    COUNT(DISTINCT PM.Material_Number) AS DistinctMaterials
FROM TB_PriceMaster PM
LEFT JOIN TB_ProductImages PI
    ON PM.CompanyCode = PI.CompanyCode
    AND (
        PM.Material_Description LIKE PI.ProductName + '%'
        OR PM.Material_Description LIKE '%' + PI.ProductName + '%'
    )
WHERE PM.CompanyCode = 1070
  AND PM.Condition_Type = 'ZBAG'
  AND (
        @CurrentDate >= PM.Valid_From
        OR PM.Valid_From IS NULL
      )
  AND (
        @CurrentDate <= PM.Valid_To
        OR PM.Valid_To IS NULL
      )
  AND (
        PM.Deletion_Indicator IS NULL
        OR PM.Deletion_Indicator NOT LIKE '%X%'
      )
  AND UPPER(LTRIM(RTRIM(PM.Crop))) <> 'UNKNOWN'
  AND PI.APIURL IS NOT NULL;





SELECT
    PM.Condition_Table,
    COUNT(*) AS MatchingRecords
FROM TB_PriceMaster PM
WHERE PM.CompanyCode = 1070
  AND PM.Condition_Type = 'ZBAG'
  AND PM.SalesOrganisation = 'AG01'
  AND PM.Condition_Table IN ('A860', 'A935', 'A933', 'A862', 'A559')
  AND PM.Condition_Amount IS NOT NULL
  AND (
        PM.Valid_From IS NULL
        OR CAST(GETDATE() AS DATE) >= PM.Valid_From
      )
  AND (
        PM.Valid_To IS NULL
        OR CAST(GETDATE() AS DATE) <= PM.Valid_To
      )
  AND (
        PM.Deletion_Indicator IS NULL
        OR PM.Deletion_Indicator NOT LIKE '%X%'
      )
GROUP BY PM.Condition_Table;

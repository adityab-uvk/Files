ALTER PROCEDURE [dbo].[GetProductsByCropInProductOff]
    @CompanyCode INT,
    @Crop        NVARCHAR(40)
AS
BEGIN
    SET NOCOUNT ON;

    BEGIN TRY

        ;WITH Ranked AS
        (
            SELECT 
                PM.CompanyCode,
                ISNULL(PM.ProductId, PI.ProductId) AS ProductId,
                PM.Material_Number,
                PM.Material_Description,
                PM.Crop,
                PM.Variety,
                PM.Stage,
                PM.Grade,
                PM.Unit_Of_Measurement,

                -- Image logic
                CASE 
                    WHEN @CompanyCode = 1070 
                        THEN CI.APIURL
                    ELSE PI.APIURL
                END AS ImagePath,

                PM.Condition_Amount,
                PM.PackSize,
                PM.DIVISION,

                -- Priority from Material Description
                PPd.Priority AS MappedPriority,

                ROW_NUMBER() OVER
                (
                    PARTITION BY PM.Material_Number
                    ORDER BY 
                        CASE 
                            WHEN PPd.Priority IS NULL THEN 1 
                            ELSE 0 
                        END,
                        PPd.Priority ASC,
                        PM.Material_Description ASC
                ) AS RowNum

            FROM TB_PriceMaster PM

            -- Existing product image logic
            LEFT JOIN TB_ProductImages PI
                ON PM.CompanyCode = PI.CompanyCode
               AND (
                    PM.Material_Description LIKE PI.ProductName + '%'
                 OR PM.Material_Description LIKE '%' + PI.ProductName + '%'
               )

            -- Category image logic for Company 1070
            OUTER APPLY
            (
                SELECT TOP 1
                    C.APIURL
                FROM dbo.CategoryImages C
                WHERE C.CompanyCode = 1070
                  AND LTRIM(RTRIM(C.CategoryName)) =
                      LTRIM(RTRIM(PM.Crop))
            ) CI

            -- Product priority
            LEFT JOIN dbo.TB_ProductPriority PPd
                ON LTRIM(RTRIM(PM.Material_Description)) =
                   LTRIM(RTRIM(PPd.Material_Description))

            WHERE 
                  PM.CompanyCode = @CompanyCode
              AND LTRIM(RTRIM(PM.Crop)) = LTRIM(RTRIM(@Crop))
              AND (
                    PM.Deletion_Indicator IS NULL
                    OR PM.Deletion_Indicator NOT LIKE '%X%'
                  )

              -- For 1070 image must come from CategoryImages
              AND
              (
                    @CompanyCode = 1070
                    OR PI.APIURL IS NOT NULL
              )

              -- For 1070 category image must exist
              AND
              (
                    @CompanyCode <> 1070
                    OR CI.APIURL IS NOT NULL
              )
        )

        SELECT 
            CompanyCode,
            Material_Number,
            Material_Description,
            Crop,
            Variety,
            Stage,
            Grade,
            Unit_Of_Measurement,
            ImagePath,
            Condition_Amount,
            PackSize,
            Division

        FROM Ranked

        WHERE RowNum = 1

        ORDER BY 
            CASE 
                WHEN MappedPriority IS NULL THEN 1 
                ELSE 0 
            END,
            MappedPriority ASC,
            Material_Description ASC;

    END TRY

    BEGIN CATCH

        INSERT INTO ErrorLog_GetProductOffering
        (
            ErrorMessage,
            ErrorSeverity,
            ErrorState,
            ProcedureName,
            ErrorLine,
            ErrorDate
        )
        VALUES
        (
            ERROR_MESSAGE(),
            ERROR_SEVERITY(),
            ERROR_STATE(),
            'GetProductsByCropInProductOff',
            ERROR_LINE(),
            GETDATE()
        );

        SELECT 
            NULL AS CompanyCode,
            NULL AS Material_Number,
            NULL AS Material_Description,
            NULL AS Crop,
            NULL AS Variety,
            NULL AS Stage,
            NULL AS Grade,
            NULL AS Unit_Of_Measurement,
            NULL AS ImagePath,
            NULL AS Condition_Amount,
            NULL AS PackSize,
            NULL AS Division;

    END CATCH
END

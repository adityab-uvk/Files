SELECT
    UserId,
    UserCode,
    CompanyCode,
    Name,
    RoleId,
    RepManCode,
    IsActive
FROM Users
WHERE LTRIM(RTRIM(UserCode)) = '25010844';

------------------------------------------------------------------------

SELECT
    CustomerId,
    CompanyCode,
    CustomerCode,
    CustomerName,
    '[' + ISNULL(TM, '') + ']' AS StoredTM,
    LEN(TM) AS TMLength,
    DATALENGTH(TM) AS TMBytes
FROM TB_CustomerMaster
WHERE LTRIM(RTRIM(ISNULL(TM, ''))) = '25010844'
ORDER BY CustomerCode;

----------------------------------------------------------------------------
SELECT
    db.Id,
    db.CustomerCode,
    cm.CustomerName,
    cm.CompanyCode,
    cm.TM,
    db.PaymentDate,
    db.AmountPaid,
    db.Status,
    db.CreatedAt
FROM TB_DepositBalance db
INNER JOIN TB_CustomerMaster cm
    ON LTRIM(RTRIM(cm.CustomerCode))
     = LTRIM(RTRIM(db.CustomerCode))
WHERE LTRIM(RTRIM(ISNULL(cm.TM, ''))) = '25010844'
ORDER BY db.CreatedAt DESC;


------------------------------------------------------------------------------------
SELECT
    db.Id,
    db.CustomerCode,
    cm.CustomerName,
    cm.CompanyCode,
    cm.TM,
    db.PaymentDate,
    db.AmountPaid,
    db.Status
FROM TB_DepositBalance db
INNER JOIN TB_CustomerMaster cm
    ON LTRIM(RTRIM(cm.CustomerCode))
     = LTRIM(RTRIM(db.CustomerCode))
    AND cm.CompanyCode = 1054
WHERE LTRIM(RTRIM(ISNULL(cm.TM, ''))) = '25010844'
ORDER BY db.CreatedAt DESC;


ALTER PROCEDURE [dbo].[UpdateContactNumber]
    @CompanyCode BIGINT,
    @UserCode NVARCHAR(50),
    @RoleId INT,
    @NewContactNumber NVARCHAR(50)
AS
BEGIN
    SET NOCOUNT ON;

    DECLARE @RowsAffected INT = 0;

    IF @RoleId = 1
    BEGIN
        -- Customer contact number
        UPDATE TB_CustomerMaster
        SET
            Telephone = @NewContactNumber,
            Updated_at = GETDATE()
        WHERE CompanyCode = @CompanyCode
          AND CustomerCode = @UserCode;

        SET @RowsAffected = @@ROWCOUNT;

        -- Update login/user record when available
        UPDATE Users
        SET
            ContactNumber = @NewContactNumber,
            Updated_At = GETDATE()
        WHERE CompanyCode = @CompanyCode
          AND UserCode = @UserCode
          AND RoleId = @RoleId;

        SET @RowsAffected = @RowsAffected + @@ROWCOUNT;
    END
    ELSE
    BEGIN
        -- TM, RM, ZM and higher roles are stored in Users
        UPDATE Users
        SET
            ContactNumber = @NewContactNumber,
            Updated_At = GETDATE()
        WHERE CompanyCode = @CompanyCode
          AND UserCode = @UserCode
          AND RoleId = @RoleId;

        SET @RowsAffected = @@ROWCOUNT;
    END

    SELECT @RowsAffected AS RowsAffected;
END;

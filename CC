 -- =========================================================
        -- TEMPORARY LOGIC FOR COMPANY 1070
        -- Show all available products without condition-table logic
        -- =========================================================

        IF @CompanyCode = 1070
        BEGIN

            SELECT DISTINCT
                PM.CompanyCode,
                PM.Material_Number,
                PM.Material_Description,
                PM.Crop,
                PM.Variety,
                PM.Stage,
                PM.Grade,
                PM.Unit_Of_Measurement,
                PI.APIURL AS ImagePath,
                PM.PackSize,
                PM.DIVISION
            FROM TB_PriceMaster PM WITH (NOLOCK)
            LEFT JOIN TB_ProductImages PI WITH (NOLOCK)
                ON PM.CompanyCode = PI.CompanyCode
                AND (
                    PM.Material_Description LIKE PI.ProductName + '%'
                    OR PM.Material_Description LIKE '%' + PI.ProductName + '%'
                )
            WHERE PM.CompanyCode = 1070
              AND PM.Condition_Type = 'ZBAG'
              AND PM.SalesOrganisation = 'MCPL'
              AND (PM.Valid_From IS NULL OR CAST(GETDATE() AS DATE) >= PM.Valid_From)
              AND (PM.Valid_To IS NULL OR CAST(GETDATE() AS DATE) <= PM.Valid_To)
              AND (
                    PM.Deletion_Indicator IS NULL
                    OR PM.Deletion_Indicator NOT LIKE '%X%'
                  )
              AND PI.APIURL IS NOT NULL
            ORDER BY PM.Material_Number;

            RETURN;
        END


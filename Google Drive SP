SELECT TOP 20
    CompanyCode,
    CreateOrderNumber,
    CartId,
    UserId,
    UserCode,
    CustomerName,
    RepManCode,
    SecondApprovalUserCode,
    ZSMCode,
    SONumber,
    OrderRejectStatus,
    Plant
FROM TB_Create_Dealer_Order
WHERE CompanyCode = 1049
  AND SONumber IS NULL
  AND (OrderRejectStatus = 0 OR OrderRejectStatus IS NULL)
ORDER BY CreateOrderNumber DESC;


DECLARE @CompanyCode BIGINT = 1054;

SELECT DISTINCT
    CM.TM AS TMCode,
    CM.Emp_Name AS CustomerMasterEmployeeName,
    CM.CompanyCode AS CustomerMasterCompanyCode,
    CM.Plant,
    CM.Region,
    CM.RegionDescription,
    CM.SalesOffice,
    CM.SalesGroup,
    CASE
        WHEN NOT EXISTS
        (
            SELECT 1
            FROM Users U
            WHERE LTRIM(RTRIM(U.UserCode)) =
                  LTRIM(RTRIM(CM.TM))
        )
        THEN 'TM does not exist in Users'

        ELSE 'TM exists in Users under another CompanyCode'
    END AS Issue
FROM TB_CustomerMaster CM
WHERE CM.CompanyCode = @CompanyCode
  AND NULLIF(LTRIM(RTRIM(CM.TM)), '') IS NOT NULL
  AND NOT EXISTS
  (
      SELECT 1
      FROM Users U
      WHERE LTRIM(RTRIM(U.UserCode)) =
            LTRIM(RTRIM(CM.TM))
        AND U.CompanyCode = CM.CompanyCode
  )
ORDER BY CM.TM;
